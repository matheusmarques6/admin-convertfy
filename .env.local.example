# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Convertfy Admin

# ============================================
# INTEGRATIONS
# ============================================

# Asaas (Payments)
# Docs: https://docs.asaas.com/
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-secret
NEXT_PUBLIC_ASAAS_ENVIRONMENT=sandbox # or production

# Meta (Facebook/Instagram Ads)
# Docs: https://developers.facebook.com/docs/marketing-apis/
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Google (Ads + Calendar)
# Docs: https://developers.google.com/google-ads/api/docs/start
# Docs: https://developers.google.com/calendar/api
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token

# Klaviyo
# Docs: https://developers.klaviyo.com/
KLAVIYO_API_KEY=your-klaviyo-api-key
KLAVIYO_PUBLIC_KEY=your-klaviyo-public-key

# Shopify
# Docs: https://shopify.dev/docs/api/admin-rest
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret

# WhatsApp Business API
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude (for Figma Email Slicer Vision API)
# Docs: https://docs.anthropic.com/en/api/getting-started
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Figma API - Personal Access Token (for Email Slicer Figma integration)
# Generate at: figma.com > Settings > Security > Personal access tokens
FIGMA_PERSONAL_TOKEN=figd_xxxxxxxxxxxx
