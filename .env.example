# ============================================
# Synkra AIOS Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOS Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOS_VERSION=2.2.0

# --------------------------------------------
# Security & Encryption
# --------------------------------------------

# Credential Encryption (32-byte hex key for AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --------------------------------------------
# Application
# --------------------------------------------

# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public client keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# --------------------------------------------
# Third-Party Integrations
# --------------------------------------------

# Shopify OAuth
# REQUIRED: SHOPIFY_API_SECRET is needed for webhook HMAC verification.
# Without it, the OAuth callback will reject all requests (500).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Google OAuth & Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta/Facebook OAuth
META_APP_ID=
META_APP_SECRET=

# Asaas Webhook
ASAAS_WEBHOOK_SECRET=

# WhatsApp Webhook
# REQUIRED: WHATSAPP_APP_SECRET is needed for webhook signature verification.
# Without it, the WhatsApp webhook will reject all POST payloads in production (401).
# In development (NODE_ENV=development), verification is skipped if not set.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Onboarding Webhook
ONBOARDING_WEBHOOK_SECRET=

# --------------------------------------------
# Email (Resend) - https://resend.com/api-keys
# --------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Convertfy

# --------------------------------------------
# N8N Campaign Generation Webhooks
# --------------------------------------------
N8N_CAMPAIGNS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/campaign-generation
# Shared secret entre admin e n8n. Usado:
#   - INBOUND  (n8n → admin): valida header x-webhook-secret
#   - OUTBOUND (admin → n8n): envia mesmo header x-webhook-secret nos webhooks
#     de campaigns e briefing confirmado
N8N_WEBHOOK_SECRET=

# N8N — Briefing confirmado (form público)
# Disparado quando o cliente clica "Confirmar e finalizar" no popup do briefing.
# Sem URL: dispatch é skipped silenciosamente (dev local funciona sem n8n).
# Autenticação reusa N8N_WEBHOOK_SECRET acima (header x-webhook-secret).
N8N_BRIEFING_WEBHOOK_URL=https://n8n-n8n.1fpac5.easypanel.host/webhook/all-briefing

# Webhook do n8n que gera copies dos emails (substitui o agente Claude interno).
# Disparado quando o briefing é finalizado OU pelo botão "Gerar copies (n8n)"
# no workspace de produção. n8n devolve as copies via callback em
# /api/webhooks/n8n/email-copy (autenticado pelo N8N_WEBHOOK_SECRET).
N8N_EMAIL_COPY_WEBHOOK_URL=

# Central de Campanhas — geração de copy POR LOJA via n8n.
# Disparado pelo botão "Gerar piloto"/"Gerar para todas" (dispatch async,
# retorna 202). n8n busca o contexto de cada loja em
# /api/admin/campaign-central/stores/[id]/context e devolve a copy por loja
# via callback /api/webhooks/n8n/campaign-copy (autenticado pelo
# N8N_WEBHOOK_SECRET). Sem esta var, o cron campaign-copy-watchdog roda o
# fallback inline (Anthropic direto) no próximo tick (até 5min).
N8N_CAMPAIGN_COPY_WEBHOOK_URL=https://n8n-n8n.1fpac5.easypanel.host/webhook/convertfy-system-campanhas

# Epic AE — gatilho hibrido (Story AE-2).
# URL do n8n para o pipeline start-onboarding (copy + image + html + qa).
# Alias aceito: a service tambem aceita N8N_EMAIL_COPY_WEBHOOK_URL acima como
# fallback se esta var nao estiver definida.
N8N_EMAIL_COPY_URL=

# Epic AE — Story AE-3 (fase 2 in-process).
# HMAC secret usado pelo header `x-internal-secret` nos endpoints
# /api/internal/* (atualmente /api/internal/run-phase2/[emailId]).
# Compartilhado entre admin e o watchdog (story AE-4).
INTERNAL_SECRET=

# Epic AE — Story AE-3 / AE-5 (QA agent).
# Severidade minima de issue que bloqueia email (marca status='failed').
# Valores: low | medium | high. Default: high (so issues high bloqueiam).
EMAIL_QA_BLOCK_SEVERITY=high

# Story AE-15: liga QA cascade vision (Claude Sonnet 4.6 com imagem).
# Default false ate ops decidir aceitar custo ~1.5c/email (so dispara
# quando filtro textual da Etapa 1 passa — sem image_nicho_mismatch high).
# Quando true, avalia paleta, overlay reserve e cena via vision API.
EMAIL_QA_VISION_ENABLED=false

# Epic AE — Story AE-4 (watchdog cron).
# Maximo de tentativas de copy generation por email antes de marcar failed.
# Atinge attempts via increment_email_attempts() em cada disparo. Cap em 3
# evita loop infinito de recovery se Claude tambem falhar.
MAX_GENERATION_ATTEMPTS=3
# Threshold (minutos) para considerar copy_generating como travada.
# Default 15 = 3x p95 do n8n (~5min com 7 emails em paralelo).
WATCHDOG_COPY_TIMEOUT_MIN=15
# Threshold (minutos) para considerar rendering/qa_running como travados.
# Default 10 = 6x p95 da fase 2 (~30-90s).
WATCHDOG_PHASE2_TIMEOUT_MIN=10
# Threshold (minutos) para re-dispatch de copy_ready stuck sem fase 2 iniciada.
# Default 3 = margem curta porque webhook deveria ter chamado after() imediato.
WATCHDOG_STALE_COPY_READY_MIN=3

# Story AE-13: liga modo multimodal (img2img) no OpenRouter pro image
# agent. Quando true, slots com mode='product_ref' enviam a imagem real
# do top product como referencia visual via content array. Default false
# ate spike empirico confirmar que gpt-5.4-image-2 aceita content array
# com image_url. Se ligado e o modelo rejeitar, a chain faz retry uma
# vez em text2img puro antes de propagar erro.
IMAGE_MULTIMODAL_ENABLED=false

# URL pública do app (necessária para informar callback ao n8n no payload).
NEXT_PUBLIC_APP_URL=https://app.convertfy.me

# --------------------------------------------
# Upstash Redis (rate limiting)
# --------------------------------------------
# Required in production for distributed rate limiting across serverless instances.
# Optional in dev — if not set, rate limiting is skipped (fail-open).
# Get from: https://console.upstash.com/ or Vercel KV integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------
# Report PDF generation (Chromium headless)
# --------------------------------------------
# Dev local: caminho de um Chrome/Chromium local para a rota de PDF não
# carregar o build lambda do @sparticuz/chromium. Na Vercel, deixe VAZIO.
# Ex.: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=
# Segredo dedicado opcional do pdf_token da página /print (fallback:
# SUPABASE_SERVICE_ROLE_KEY quando vazio).
PDF_TOKEN_SECRET=

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below
